    {
      "name": "todo/writes_the_file",
      "why": "the todo list is persisted exactly as specified, and counted",
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "todo_write",
              "arguments": {
                "items": [
                  {
                    "text": "one",
                    "done": false
                  },
                  {
                    "text": "two",
                    "done": true
                  }
                ]
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "files": {
          ".harness/todo.json": "[\n  {\n    \"text\": \"one\",\n    \"done\": false\n  },\n  {\n    \"text\": \"two\",\n    \"done\": true\n  }\n]\n"
        },
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "content": "todo: 2 items (1 done)"
              }
            ]
          }
        ]
      }
    },
