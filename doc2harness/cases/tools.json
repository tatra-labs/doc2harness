    {
      "name": "todo/no_state_directory_otherwise",
      "why": "the harness keeps no state in the workspace unless todo_write is called",
      "files": {
        "a.txt": "hello\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "read_file",
              "arguments": {
                "path": "a.txt"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
