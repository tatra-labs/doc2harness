    {
      "name": "write/truncates",
      "why": "writing an existing file replaces it rather than appending",
      "files": {
        "a.txt": "a long old line\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "write_file",
              "arguments": {
                "path": "a.txt",
                "content": "new\n"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "files": {
          "a.txt": "new\n"
        }
      }
    },
    {
      "name": "edit/replaces_once",
      "why": "a unique edit replaces exactly that text",
      "files": {
        "a.txt": "alpha beta gamma\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "edit_file",
              "arguments": {
                "path": "a.txt",
                "old": "beta",
                "new": "delta"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "files": {
          "a.txt": "alpha delta gamma\n"
        },
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "content": "replaced old with new in a.txt"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "edit/not_found",
      "why": "an edit that matches nothing fails and leaves the file alone",
      "files": {
        "a.txt": "alpha\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "edit_file",
              "arguments": {
                "path": "a.txt",
                "old": "beta",
                "new": "delta"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "files": {
          "a.txt": "alpha\n"
        },
        "stdout_has": [
          "error: old string not found in a.txt"
        ],
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "content": "ERROR: old string not found in a.txt"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "edit/not_unique",
      "why": "an ambiguous edit fails, counts the matches, and changes nothing",
      "files": {
        "a.txt": "x\nx\nx\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "edit_file",
              "arguments": {
                "path": "a.txt",
                "old": "x",
                "new": "y"
