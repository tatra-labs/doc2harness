        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "files": {
          "a.txt": "x\nx\nx\n"
        },
        "stdout_has": [
          "error: old string is not unique in a.txt: 3 occurrences"
        ],
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "content": "ERROR: old string is not unique in a.txt: 3 occurrences"
              }
            ]
          }
        ]
      }
    },
