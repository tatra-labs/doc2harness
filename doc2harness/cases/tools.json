{
  "category": "tools",
  "about": "Section 3: the seven tools, their result strings and their failures.",
  "cases": [
    {
      "name": "read/plain",
      "why": "a file's contents go back as the tool result, unchanged",
      "files": {
        "a.txt": "hello\nworld\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "read_file",
              "arguments": {
                "path": "a.txt"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "stdout_has": [
          "tool: read_file"
        ],
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "role": "tool",
                "content": "hello\nworld\n"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "read/missing",
      "why": "a missing file is a tool failure with a fixed message, not a crash",
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "read_file",
              "arguments": {
                "path": "nope.txt"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "request_count": 2,
        "stdout_has": [
          "error: no such file: nope.txt"
        ],
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "role": "tool",
                "tool_call_id": "c1",
                "content": "ERROR: no such file: nope.txt"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "read/directory",
      "why": "reading a directory has its own message",
      "files": {
        "sub/x.txt": "x\n"
      },
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "read_file",
              "arguments": {
                "path": "sub"
