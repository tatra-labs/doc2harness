                "content": "ERROR: no such file: nope.txt"
              },
              {
                "at": 4,
                "tool_call_id": "c2",
                "content": "ERROR: no such directory: nope"
              },
              {
                "at": 5,
                "tool_call_id": "c3",
                "content": "ERROR: no such file: nope.txt"
              }
            ]
          }
        ]
      }
