                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "stdout_has": [
          "error: not a file: sub"
        ],
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "content": "ERROR: not a file: sub"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "write/creates_parents",
      "why": "write_file creates missing directories and reports the byte count",
      "script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "write_file",
              "arguments": {
                "path": "out/deep/a.txt",
                "content": "hi\n"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "f",
              "name": "finish",
              "arguments": {
                "success": true,
                "summary": "ok"
              }
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "files": {
          "out/deep/a.txt": "hi\n"
        },
        "requests": [
          {
            "index": 1,
            "messages": [
              {
                "at": 3,
                "content": "wrote 3 bytes to out/deep/a.txt"
              }
            ]
          }
        ]
      }
    },
    {
