{
  "category": "tokens",
  "about": "Section 2.6: the token totals, and when they are reported.",
  "cases": [
    {
      "name": "tokens/summed_across_turns",
      "why": "the totals add up every successful response",
      "files": {"a.txt": "hello\n"},
      "script": [
        {"tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}], "usage": {"prompt_tokens": 10, "completion_tokens": 2}},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}], "usage": {"prompt_tokens": 20, "completion_tokens": 5}}
      ],
      "expect": {"exit_code": 0, "stdout_last": "tokens: prompt=30 completion=7"}
    },
    {
      "name": "tokens/absent_usage_is_zero",
      "why": "a response without usage contributes nothing",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {"exit_code": 0, "stdout_last": "tokens: prompt=0 completion=0"}
    },
    {
      "name": "tokens/partial_usage",
      "why": "a missing field inside usage counts as zero, it does not void the rest",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}], "usage": {"prompt_tokens": 4}}],
      "expect": {"exit_code": 0, "stdout_last": "tokens: prompt=4 completion=0"}
    },
    {
      "name": "tokens/last_line_on_turn_cap",
      "why": "the totals are reported when the turn cap ends the run",
      "files": {"a.txt": "hello\n"},
      "extra": ["--max-turns", "1"],
      "script": [{"tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}], "usage": {"prompt_tokens": 3, "completion_tokens": 1}}],
      "expect": {"exit_code": 1, "stdout_last": "tokens: prompt=3 completion=1"}
    },
    {
      "name": "tokens/last_line_on_task_failure",
      "why": "the totals are reported when finish reports failure",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": false, "summary": "no"}}], "usage": {"prompt_tokens": 8, "completion_tokens": 9}}],
      "expect": {"exit_code": 1, "stdout_last": "tokens: prompt=8 completion=9"}
    },
    {
      "name": "tokens/retry_counts_once",
      "why": "a failed attempt has no usage to count",
      "script": [
        {"status": 500},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}], "usage": {"prompt_tokens": 6, "completion_tokens": 1}}
      ],
      "expect": {"exit_code": 0, "stdout_last": "tokens: prompt=6 completion=1"}
    },
    {
      "name": "tokens/text_end_reports_totals",
      "why": "ending on text still reports the totals, after the done line",
      "script": [{"content": "nothing to do", "usage": {"prompt_tokens": 2, "completion_tokens": 3}}],
      "expect": {
        "exit_code": 0,
        "stdout": ["assistant: nothing to do", "done: nothing to do", "tokens: prompt=2 completion=3"]
      }
    }
  ]
}
