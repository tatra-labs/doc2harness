{
  "category": "protocol",
  "about": "Section 2: the request body, the system prompt, the tool list and the conversation.",
  "cases": [
    {
      "name": "protocol/system_prompt",
      "why": "the system prompt is fixed text with the resolved workspace path in it",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "system": "You are a coding agent. You are working in the directory {workdir}.\nUse the provided tools to complete the user's task.\nCall finish when the task is done or cannot be done."}]
      }
    },
    {
      "name": "protocol/body_keys",
      "why": "the body carries exactly five keys",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "keys": ["model", "turn", "messages", "tools", "max_turns"]}]
      }
    },
    {
      "name": "protocol/defaults",
      "why": "model-name, turn and max-turns have the documented defaults",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "field": {"model": "mock-1", "turn": 1, "max_turns": 10}}]
      }
    },
    {
      "name": "protocol/content_type",
      "why": "requests are declared as JSON",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {"exit_code": 0, "content_type": "application/json"}
    },
    {
      "name": "protocol/endpoint",
      "why": "the request goes to /v1/chat under the given base URL and nowhere else",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {"exit_code": 0, "misroutes": 0, "request_count": 1}
    },
    {
      "name": "protocol/user_message",
      "why": "the prompt is the second message, verbatim, and there are only two to start",
      "prompt": "fix the failing test",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "message_count": 2, "messages": [{"at": 1, "role": "user", "content": "fix the failing test"}]}]
      }
    },
    {
      "name": "protocol/tool_names",
      "why": "all seven tools are offered, sorted by name",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "tools_sorted": true, "tool_names": ["edit_file", "finish", "list_dir", "read_file", "run_command", "todo_write", "write_file"]}]
      }
    },
    {
      "name": "protocol/tool_required",
      "why": "each tool declares its required arguments, in the documented order",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "tool_required": {
          "edit_file": ["path", "old", "new"],
          "finish": ["success", "summary"],
          "list_dir": ["path"],
          "read_file": ["path"],
          "run_command": ["command"],
          "todo_write": ["items"],
          "write_file": ["path", "content"]
        }}]
      }
    },
    {
      "name": "protocol/tool_properties",
      "why": "each tool declares exactly its documented parameters",
      "script": [{"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 0, "tool_properties": {
          "edit_file": ["new", "old", "path"],
          "finish": ["success", "summary"],
          "list_dir": ["path"],
          "read_file": ["path"],
          "run_command": ["command"],
          "todo_write": ["items"],
          "write_file": ["content", "path"]
        }}]
      }
    },
    {
      "name": "protocol/conversation_grows",
      "why": "the next request carries the assistant turn and the tool result, in that order",
      "files": {"a.txt": "hello\n"},
      "script": [
        {"tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}
      ],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 1, "message_count": 4, "messages": [
          {"at": 0, "role": "system"},
          {"at": 1, "role": "user"},
          {"at": 2, "role": "assistant", "content": null, "tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}]},
          {"at": 3, "role": "tool", "tool_call_id": "c1", "content": "hello\n"}
        ]}]
      }
    },
    {
      "name": "protocol/echoes_content",
      "why": "assistant text is echoed back with the tool calls it came with",
      "files": {"a.txt": "hello\n"},
      "script": [
        {"content": "let me look", "tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}
      ],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 1, "messages": [{"at": 2, "role": "assistant", "content": "let me look"}]}]
      }
    },
    {
      "name": "protocol/two_calls_two_results",
      "why": "two tool calls in one turn produce two tool messages, in call order",
      "files": {"a.txt": "first\n", "b.txt": "second\n"},
      "script": [
        {"tool_calls": [
          {"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}},
          {"id": "c2", "name": "read_file", "arguments": {"path": "b.txt"}}
        ]},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}
      ],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 1, "message_count": 5, "messages": [
          {"at": 3, "role": "tool", "tool_call_id": "c1", "content": "first\n"},
          {"at": 4, "role": "tool", "tool_call_id": "c2", "content": "second\n"}
        ]}]
      }
    },
    {
      "name": "protocol/turn_increments",
      "why": "turn counts requests from one",
      "files": {"a.txt": "hello\n"},
      "script": [
        {"tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "c2", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}
      ],
      "expect": {
        "exit_code": 0,
        "request_count": 3,
        "requests": [
          {"index": 0, "field": {"turn": 1}},
          {"index": 1, "field": {"turn": 2}},
          {"index": 2, "field": {"turn": 3}}
        ]
      }
    },
    {
      "name": "protocol/system_stays_first",
      "why": "the system message appears once, at index zero, in every request",
      "files": {"a.txt": "hello\n"},
      "script": [
        {"tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "c2", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}
      ],
      "expect": {
        "exit_code": 0,
        "requests": [
          {"index": 2, "message_count": 6, "system": "You are a coding agent. You are working in the directory {workdir}.\nUse the provided tools to complete the user's task.\nCall finish when the task is done or cannot be done.", "messages": [
            {"at": 1, "role": "user"},
            {"at": 2, "role": "assistant"},
            {"at": 3, "role": "tool"},
            {"at": 4, "role": "assistant"},
            {"at": 5, "role": "tool"}
          ]}
        ]
      }
    },
    {
      "name": "protocol/tools_in_every_request",
      "why": "the tool list is not sent only on the first turn",
      "files": {"a.txt": "hello\n"},
      "script": [
        {"tool_calls": [{"id": "c1", "name": "read_file", "arguments": {"path": "a.txt"}}]},
        {"tool_calls": [{"id": "f", "name": "finish", "arguments": {"success": true, "summary": "ok"}}]}
      ],
      "expect": {
        "exit_code": 0,
        "requests": [{"index": 1, "tool_names": ["edit_file", "finish", "list_dir", "read_file", "run_command", "todo_write", "write_file"]}]
      }
    }
  ]
}
